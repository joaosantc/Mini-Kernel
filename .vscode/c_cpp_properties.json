{
  "configurations": [
    {
      "name": "RISC-V 32",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/kernel",
        "${workspaceFolder}/user",
        "${workspaceFolder}/common"
      ],
      "compilerPath": "/usr/bin/clang",
      "compilerArgs": [
        "--target=riscv32-unknown-elf",
        "-ffreestanding",
        "-nostdlib",
        "-Ikernel",
        "-Iuser",
        "-Icommon"
      ],
      "cStandard": "c11",
      "compileCommands": "${workspaceFolder}/.vscode/compile_commands.json"
    }
  ],
  "version": 4
}
